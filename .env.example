# Postgres connection string (Neon, Vercel Postgres, Supabase, etc.)
# Neon: https://console.neon.tech (free tier)
# Vercel Postgres: created via the Vercel dashboard, provisioned as POSTGRES_URL automatically
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Outscraper API key — https://app.outscraper.com/profile
OUTSCRAPER_API=your_key_here

# Optional: how many reviews to pull per sync (default 100).
# Outscraper bills per review, so raise/lower this to match your budget.
# OUTSCRAPER_REVIEWS_LIMIT=100
